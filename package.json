{
  "name": "seyo-agent",
  "version": "2.0.0",
  "private": true,
  "description": "岁语 · 陪老人说话的智能体：细心应答、把老人讲的话整理简化后存进独立数据库、老人再提起时搜索主句库作答",
  "type": "module",
  "engines": { "node": ">=23.4.0" },
  "scripts": {
